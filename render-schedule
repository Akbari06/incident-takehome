#!/usr/bin/env python3
"""CLI entry point for the on-call schedule renderer."""

from datetime import datetime, timedelta, timezone

def generate_schedule(users, handover_start, handover_interval_days, num_periods):
    """Generate a simple on-call schedule."""
    schedule = []
    current_date = handover_start
    interval = timedelta(days=handover_interval_days)
    for i in range(num_periods):
        end = current_date + interval # Calculate end date
        user = users[i % len(users)] # Rotate through users
        schedule.append({
            "user": user,
            "start": current_date,
            "end": end
        })
        current_date = end # Move to next period

    return schedule

def apply_overrides(schedule, overrides):
    """Apply overrides to the schedule."""
    new_schedule = []

    for entry in schedule:
        start, end = entry["start"], entry["end"]

        # Find overrides that overlap with this interval
        overlapping_overrides = [
            o for o in overrides
            if not (o["end"] <= start or o["start"] >= end)
        ]

        # If no overrides affect this entry, keep it as is
        if not overlapping_overrides:
            new_schedule.append(entry)
            continue

        current_start = start
        for override in sorted(overlapping_overrides, key=lambda o: o["start"]):
            # Segment before the override
            if override["start"] > current_start:
                new_schedule.append({
                    "user": entry["user"],
                    "start": current_start,
                    "end": override["start"]
                })

            # Add the override itself
            new_schedule.append(override)

            # Move current start forward
            current_start = max(current_start, override["end"])

        # Segment after the last override
        if current_start < end:
            new_schedule.append({
                "user": entry["user"],
                "start": current_start,
                "end": end
            })

    return new_schedule
